# Env
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.python-version

# Node
node_modules/
npm-debug.log*
yarn-debug.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
.obsidian/

# Claude Code project-level installs (kept out of repo — install via README)
.claude/agents/
.claude/skills/
.claude/settings.local.json

# Scratch
scratch/
tmp/
*.tmp

# Books — only public-domain or markdown notes get versioned; copyrighted PDFs/EPUBs are not pushed
books/*.pdf
books/*.epub
books/*.mobi
!books/README.md
!books/notes/

# Discovery raw dumps (large JSON/CSV) — summaries get written into notes/discoveries/
notes/raw/
*.csv
*.jsonl
